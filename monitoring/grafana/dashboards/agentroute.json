{
  "title": "AgentRoute HTTP",
  "uid": "agentroute-http",
  "schemaVersion": 41,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "agentroute-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agentroute_http_requests_total[5m])) by (route)"
        }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s"
}
